      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/units",
      "destination": "/library",
      "statusCode": 308,
      "regex": "^(?!/_next)/units(?:/)?$"
    },
    {
      "source": "/units/:path*",
      "destination": "/library/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)/units(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
